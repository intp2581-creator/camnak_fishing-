{
  "rules": {
    "plaza": {
      "$room": {
        ".read": "auth != null",
        "$channel": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "status_nick": {
      ".read": "auth != null",
      "$nick": {
        ".write": "auth != null"
      }
    },
    "login_session": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "raid_lobby": {
      "$guild": {
        ".read": "auth != null",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "state": {
          ".write": "auth != null"
        }
      }
    },
    "raid_battle": {
      "$guild": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "fishing_live": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "meta": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "state": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "watchers": {
          "$w": {
            ".write": "auth != null && auth.uid === $w"
          }
        }
      }
    },
    "arena_logs": {
      ".read": "auth != null",
      "$room": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
